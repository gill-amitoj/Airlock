# Environment Configuration Template
# Copy this file to .env and fill in your values

# Flask settings
FLASK_APP=src.api.app:create_app
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_engine
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis settings
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Worker settings
WORKER_CONCURRENCY=4
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=300.0
TASK_TIMEOUT=3600

# Queue settings
QUEUE_NAME=workflow_tasks
QUEUE_PROCESSING_TIMEOUT=30

# Outbound HTTP allowlist
# Comma-separated hostnames that http_request steps may call. Step URLs come
# from API callers and from the AI workflow generator, so this list - not the
# generator's prompt - is what constrains where the engine sends requests.
# Hosts resolving to private, loopback or link-local addresses are always
# refused, even if listed here. Unset means the defaults in src/config/settings.py.
ALLOWED_HTTP_HOSTS=official-joke-api.appspot.com,catfact.ninja,randomuser.me,api.quotable.io,dog.ceo,www.boredapi.com,wttr.in,hacker-news.firebaseio.com,jsonplaceholder.typicode.com

# LLM settings (AI workflow generator)
# Set to false where no Ollama server is available (e.g. the Azure deployment).
LLM_ENABLED=true
# The Ollama endpoint is operator-configured and is exempt from the allowlist
# above - that allowlist governs URLs supplied by users and by the model.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=llama3.2:1b
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_NUM_PREDICT=500
# Maximum steps a single AI-generated workflow may contain
LLM_MAX_STEPS=10

# Write access
# When set, POST requests need it in the X-API-Key header (the dashboard asks
# for it). Required when FLASK_ENV=production; the app refuses to start without.
API_KEY=

# HTTP hardening
# Comma-separated allowed CORS origins; empty disables CORS entirely.
CORS_ORIGINS=*
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_WRITES=30 per minute
# Number of reverse proxies whose X-Forwarded-For is trusted (1 on Azure).
TRUSTED_PROXY_HOPS=0
MAX_REQUEST_BYTES=262144

# Logging
LOG_LEVEL=INFO
